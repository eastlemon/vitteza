# VITTEZA — шаблон окружения для локального запуска в контейнере.
# Копируется в .env при первом старте контейнера (docker/entrypoint.sh).
# Значения DB_* перекрываются переменными из docker-compose.yml.

APP_NAME=VITTEZA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_ADMIN_PASSWORD=password
APP_DEMO_PASSWORD=password

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vitteza
DB_USERNAME=vitteza
DB_PASSWORD=vitteza_dev_password

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@vitteza.ru"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
